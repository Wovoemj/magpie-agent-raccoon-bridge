{
  "name": "magpie-agent-raccoon-bridge",
  "version": "0.4.0",
  "description": "Make 商汤小浣熊 (RaccoonWork) use the model configured in Magpie, sign in from a browser, and claim its daily credits. Raccoon's own login is untouched.",
  "type": "module",
  "main": "./plugin.js",
  "bin": {
    "raccoon-magpie": "./bin/raccoon-magpie.js"
  },
  "license": "MIT",
  "author": "Wovoemj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wovoemj/magpie-agent-raccoon-bridge.git"
  },
  "homepage": "https://github.com/Wovoemj/magpie-agent-raccoon-bridge#readme",
  "bugs": {
    "url": "https://github.com/Wovoemj/magpie-agent-raccoon-bridge/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "magpie": {
    "agent": "./agent.js",
    "name": "Raccoon · Magpie Bridge",
    "icon": "data:image/png;base64,"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "darwin"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "status": "node bin/raccoon-magpie.js status",
    "sync": "node bin/raccoon-magpie.js sync",
    "restore": "node bin/raccoon-magpie.js restore",
    "uninstall": "node bin/raccoon-magpie.js uninstall",
    "doctor": "node bin/raccoon-magpie.js doctor",
    "checkin": "node bin/raccoon-magpie.js checkin"
  },
  "files": [
    "agent.js",
    "plugin.js",
    "bin",
    "lib",
    "icon.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "magpie",
    "magpie-agent",
    "raccoon",
    "xiaohuanxiong",
    "sensetime",
    "byok",
    "routing-group"
  ]
}
